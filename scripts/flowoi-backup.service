[Unit]
Description=Flowoi DB backup (pg_dump + rotate + S3 upload)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/flowoi-backup.sh auto
# S3 upload в той же service-unit — если /etc/flowoi/s3.env нет,
# скрипт молча выйдет с кодом 0 (см. backup_s3_upload.sh).
ExecStartPost=/usr/local/bin/flowoi-backup-s3.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=1200
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=5
