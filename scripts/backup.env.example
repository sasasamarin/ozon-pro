# Flowoi backup config — копировать на VPS в /etc/flowoi/backup.env (chmod 600 root:root)
#
# Значения берутся из backend/.env на VPS (DATABASE_URL_SYNC),
# но дублируются здесь чтобы backup не зависел от наличия Python окружения.

DB_HOST=45.157.160.36
DB_PORT=5432
DB_USER=ozonuser
DB_PASSWORD=REPLACE_ME
DB_NAME=ozonpro
# Managed Selectel требует SSL
DB_SSLMODE=require

# Опционально — иначе берётся /root/backups/auto
# BACKUP_DIR=/root/backups/auto
