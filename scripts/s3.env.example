# Flowoi S3 backup config — копировать на VPS в /etc/flowoi/s3.env (chmod 600 root:root)
#
# Selectel Object Storage:
#   1. https://my.selectel.ru/storage → создать bucket «flowoi-backups»
#   2. https://my.selectel.ru/profile/users/service → создать сервисного юзера
#      с доступом к этому bucket'у только на read/write/list
#   3. Сгенерировать S3-ключи (access + secret) для этого юзера

S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
S3_BUCKET=flowoi-backups
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
# Опционально: префикс внутри bucket'а
S3_PREFIX=db/
