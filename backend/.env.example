# ============================================
# OZON PRO BACKEND - переменные окружения
# ============================================
# Скопируй в .env и заполни реальными значениями

# --- ОКРУЖЕНИЕ ---
ENVIRONMENT=development              # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# --- БЕЗОПАСНОСТЬ ---
# Сгенерируй командой: openssl rand -hex 32
SECRET_KEY=замени_на_сгенерированный_ключ_64_символа
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Ключ для шифрования API ключей Озона в БД
# Сгенерируй: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=замени_на_сгенерированный_fernet_ключ

# --- БАЗА ДАННЫХ (PostgreSQL + TimescaleDB) ---
DATABASE_URL=postgresql+asyncpg://ozonuser:password@db:5432/ozonpro
DATABASE_URL_SYNC=postgresql://ozonuser:password@db:5432/ozonpro
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# --- REDIS (кэш и очереди Celery) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- S3 (Selectel Object Storage) ---
S3_ENDPOINT_URL=https://s3.selcdn.ru
S3_BUCKET=ozon-pro-files
S3_ACCESS_KEY=замени
S3_SECRET_KEY=замени
S3_REGION=ru-1

# --- CLAUDE AI ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL_HAIKU=claude-haiku-4-5
CLAUDE_MODEL_SONNET=claude-sonnet-4-6
CLAUDE_MODEL_OPUS=claude-opus-4-7

# --- SENTRY (отслеживание ошибок) ---
SENTRY_DSN=                          # оставь пустым если пока не подключаем
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- EMAIL (UniSender) ---
SMTP_HOST=smtp.unisender.com
SMTP_PORT=465
SMTP_USER=замени
SMTP_PASSWORD=замени
EMAIL_FROM=noreply@ozonpro.ru
EMAIL_FROM_NAME=Ozon Pro

# --- TELEGRAM BOT ---
TELEGRAM_BOT_TOKEN=                  # получи у @BotFather в Telegram

# --- ОЗОН API (общие настройки для всех клиентов) ---
OZON_API_BASE_URL=https://api-seller.ozon.ru
OZON_PERFORMANCE_API_BASE_URL=https://api-performance.ozon.ru
OZON_WEBHOOK_SECRET=                 # секрет для проверки webhook подписей

# --- ОГРАНИЧЕНИЯ (Rate Limits) ---
RATE_LIMIT_FREE=100                  # запросов в час на Free тарифе
RATE_LIMIT_STARTER=1000
RATE_LIMIT_PRO=5000
RATE_LIMIT_BUSINESS=20000

# --- ХОСТЫ И CORS ---
ALLOWED_HOSTS=localhost,127.0.0.1,ozonpro.ru
CORS_ORIGINS=http://localhost:5173,https://ozonpro.ru

# --- ФРОНТЕНД ---
FRONTEND_URL=https://ozonpro.ru
